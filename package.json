{
  "name": "capacitator-electron",
  "version": "1.0.0",
  "description": "Sprint Planning Calculator - Electron TypeScript Desktop Application",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node build-script.js",
    "watch": "tsc -w",
    "start": "npm run build && electron .",
    "dev": "concurrently \"npm run watch\" \"wait-on dist/main.js && electron .\"",
    "pack": "electron-builder",
    "dist": "npm run build && electron-builder",
    "clean": "rimraf dist"
  },
  "keywords": [
    "sprint",
    "planning",
    "agile",
    "capacity",
    "electron",
    "typescript"
  ],
  "author": "Omaciel",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.capacitator.sprintplanner",
    "productName": "Capacitator Sprint Planner",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}